# ── Evolution API — copier vers .env et remplacer chaque CHANGER_MOI ──
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(32))"

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
LANGUAGE=fr

# Clé globale : la même valeur va dans EVOLUTION_API_KEY côté Django. Ne jamais l'exposer au navigateur.
AUTHENTICATION_API_KEY=CHANGER_MOI
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# Pas de télémétrie (activée par défaut dans Evolution API)
TELEMETRY_ENABLED=false

# Les instances restent connectées (pas de suppression automatique)
DEL_INSTANCE=false

# Nom affiché dans « Appareils connectés » du téléphone
CONFIG_SESSION_PHONE_CLIENT=AfriMarket
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# Base de données interne d'Evolution API (indépendante de celle de Django)
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=CHANGER_MOI
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGER_MOI@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=afrimarket
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Les webhooks sont configurés par instance depuis Django (URL + en-tête secret) : pas de webhook global
WEBHOOK_GLOBAL_ENABLED=false

LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
